# ──────────────────────────────────────
# Discord
# ──────────────────────────────────────
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-dev-server-id          # optional — for dev-only command registration

# ──────────────────────────────────────
# Database (used by src/core/database.ts)
# ──────────────────────────────────────
DATABASE_URL=postgresql://nxtgen:nxtgen@localhost:5432/nxtgen

# ──────────────────────────────────────
# Redis (used by src/core/redis.ts)
# ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────
# Hono API Server (used by src/core/server.ts)
# ──────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# ──────────────────────────────────────
# GitHub Webhooks (verified in src/features/github/webhooks/verify.ts)
# ──────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your-webhook-secret    # used to verify incoming webhook payloads
GITHUB_TOKEN=your-github-personal-access-token  # Octokit enrichment + issue creation — fine-grained PAT (read: Pull requests & Checks, write: Issues)
GITHUB_ISSUES_REPO=owner/repo                   # optional — repo for the "Create Issue" context menu (write: Issues)
GITHUB_CLIENT_ID=your_client_id_from_github
GITHUB_CLIENT_SECRET=your_client_secret_from_github
PUBLIC_URL=https://your-cloudflared-url.com # any public URL 

# ──────────────────────────────────────
# Logging (configures src/core/logger.ts)
# ──────────────────────────────────────
LOG_LEVEL=info                               # trace | debug | info | warn | error | fatal

# ──────────────────────────────────────
# Environment
# ──────────────────────────────────────
NODE_ENV=development